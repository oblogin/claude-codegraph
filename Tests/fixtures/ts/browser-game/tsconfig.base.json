{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@engine": ["src/engine/index.ts"],
      "@engine/*": ["src/engine/*"],
      "@game/*": ["src/game/*"],
      "@util": ["src/util/index.ts"]
    }
  }
}
